# PostgreSQL Configuration
DB_URL=jdbc:postgresql://localhost:5432/blistra
DB_USERNAME=blistra
DB_PASSWORD=blistra
DB_NAME=blistra

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-minimum-32-bytes-change-in-production-XXXXXXXX
JWT_EXPIRATION=86400000

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Production email (SMTP, e.g. Brevo). See docs/deployment.md
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
BLISTRA_OTP_PEPPER=
BLISTRA_CORS_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
