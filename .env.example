# PostgreSQL Configuration
DB_URL=jdbc:postgresql://localhost:5432/blistra
DB_USERNAME=blistra
DB_PASSWORD=blistra
DB_NAME=blistra

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-minimum-32-bytes-change-in-production-XXXXXXXX
JWT_EXPIRATION=86400000

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
# Container/production default: postgres (no paid Render disk).
# Standalone development defaults to filesystem unless this is set.
DOCUMENTS_STORAGE_BACKEND=postgres
# Conservative aggregate upload limit for the existing Neon database (64 MiB).
DOCUMENTS_MAX_TOTAL_BYTES=67108864

# Production email (SMTP, e.g. Brevo). See docs/deployment.md
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
BLISTRA_OTP_PEPPER=
# Production outbox: base64 of 32 random bytes; store separately from the pepper.
BLISTRA_OTP_DELIVERY_KEY=
# Optional operator-only metrics. Leave empty to disable the scrape endpoint.
BLISTRA_METRICS_TOKEN=
# Only actual ingress proxy IPs/CIDRs. Empty ignores forwarding headers.
BLISTRA_TRUSTED_PROXIES=
BLISTRA_AUTH_GLOBAL_MAXIMUM=1000
BLISTRA_CORS_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
